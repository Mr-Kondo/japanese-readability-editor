    {"id": 1, "reading": "あう", "page": 8, "variants": [{"forms": ["会う"], "gloss": "主に人と人が顔を合わせる。"}, {"forms": ["合う"], "gloss": "一致する。調和する。互いにする。"}, {"forms": ["遭う"], "gloss": "思わぬことや好ましくない出来事に出くわす。"}]},
    {"id": 2, "reading": "あからむ", "page": 8, "variants": [{"forms": ["赤らむ"], "gloss": "赤くなる。"}, {"forms": ["明らむ"], "gloss": "明るくなる。"}]},
    {"id": 3, "reading": "あがる・あげる", "page": 8, "variants": [{"forms": ["上がる", "上げる"], "gloss": "位置・程度などが高い方に動く。与える。声や音を出す。終わる。"}, {"forms": ["揚がる", "揚げる"], "gloss": "空中に浮かぶ。場所を移す。油で調理する。"}, {"forms": ["挙がる", "挙げる"], "gloss": "はっきりと示す。結果を残す。執り行う。こぞってする。捕らえる。"}]},
    {"id": 4, "reading": "あく・あける", "page": 8, "variants": [{"forms": ["明く", "明ける"], "gloss": "目が見えるようになる。期間が終わる。遮っていたものがなくなる。"}, {"forms": ["空く", "空ける"], "gloss": "からになる。"}, {"forms": ["開く", "開ける"], "gloss": "ひらく。"}]},
    {"id": 5, "reading": "あし", "page": 9, "variants": [{"forms": ["足"], "gloss": "足首から先の部分*。歩く，走る，行くなどの動作に見立てたもの。"}, {"forms": ["脚"], "gloss": "動物の胴から下に伸びた部分。また，それに見立てたもの。"}]},
    {"id": 6, "reading": "あたい", "page": 9, "variants": [{"forms": ["値"], "gloss": "値打ち。文字や式が表す数値。"}, {"forms": ["価"], "gloss": "値段。価格。"}]},
    {"id": 7, "reading": "あたたかい・あたたかだ・あたたまる・あたためる", "page": 9, "variants": [{"forms": ["温かい", "温かだ", "温まる", "温める"], "gloss": "冷たくない。愛情や思いやりが感じられる。"}, {"forms": ["暖かい", "暖かだ", "暖まる", "暖める"], "gloss": "寒くない（主に気象や気温で使う）。"}]},
    {"id": 8, "reading": "あつい", "page": 9, "variants": [{"forms": ["熱い"], "gloss": "温度がとても高く感じられる。感情が高ぶる。"}, {"forms": ["暑い"], "gloss": "不快になるくらい気温が高い。"}]},
    {"id": 9, "reading": "あてる", "page": 9, "variants": [{"forms": ["当てる"], "gloss": "触れる。的中する。対応させる。"}, {"forms": ["充てる"], "gloss": "ある目的や用途に振り向ける。"}, {"forms": ["宛てる"], "gloss": "手紙などの届け先とする。"}]},
    {"id": 10, "reading": "あと", "page": 9, "variants": [{"forms": ["後"], "gloss": "（⇔先・前）。順序や時間などが遅いこと。次に続くもの。"}, {"forms": ["跡"], "gloss": "通り過ぎた所に残された印。何かが行われたり存在したりした印。家督。"}, {"forms": ["痕"], "gloss": "傷のように生々しく残る印。"}]},
    {"id": 11, "reading": "あぶら", "page": 10, "variants": [{"forms": ["油"], "gloss": "常温で液体状のもの（主に植物性・鉱物性）。"}, {"forms": ["脂"], "gloss": "常温で固体状のもの（主に動物性）。皮膚から分泌される脂肪。"}]},
    {"id": 12, "reading": "あやしい", "page": 10, "variants": [{"forms": ["怪しい"], "gloss": "疑わしい。普通でない。はっきりしない。"}, {"forms": ["妖しい"], "gloss": "なまめかしい。神秘的な感じがする。"}]},
    {"id": 13, "reading": "あやまる", "page": 10, "variants": [{"forms": ["誤る"], "gloss": "間違う。"}, {"forms": ["謝る"], "gloss": "わびる。"}]},
    {"id": 14, "reading": "あらい", "page": 10, "variants": [{"forms": ["荒い"], "gloss": "勢いが激しい。乱暴である。"}, {"forms": ["粗い"], "gloss": "細かくない。雑である。"}]},
    {"id": 15, "reading": "あらわす・あらわれる", "page": 10, "variants": [{"forms": ["表す", "表れる"], "gloss": "思いが外に出る。表現する。表に出る。"}, {"forms": ["現す", "現れる"], "gloss": "隠れていたものが見えるようになる。"}, {"forms": ["著す"], "gloss": "本などを書いて世に出す。"}]},
