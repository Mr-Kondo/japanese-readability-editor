    {"id": 17, "reading": "あわせる", "page": 11, "variants": [{"forms": ["合わせる"], "gloss": "一つにする。一致させる。合算する。"}, {"forms": ["併せる"], "gloss": "別のものを並べて一緒に行う。"}]},
    {"id": 18, "reading": "いく・ゆく", "page": 11, "variants": [{"forms": ["行く"], "gloss": "移動する。進む。過ぎ去る。"}, {"forms": ["逝く"], "gloss": "亡くなる。"}]},
