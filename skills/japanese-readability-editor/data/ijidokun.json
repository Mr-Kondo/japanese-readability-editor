    {"id": 75, "reading": "たずねる", "page": 21, "variants": [{"forms": ["尋ねる"], "gloss": "問う。捜し求める。調べる。"}, {"forms": ["訪ねる"], "gloss": "おとずれる。"}]},
    {"id": 76, "reading": "たたかう", "page": 21, "variants": [{"forms": ["戦う"], "gloss": "武力や知力などを使って争う。勝ち負けや優劣を競う。"}, {"forms": ["闘う"], "gloss": "困難や障害などに打ち勝とうとする。闘争する。"}]},
    {"id": 77, "reading": "たつ", "page": 21, "variants": [{"forms": ["断つ"], "gloss": "つながっていたものを切り離す。やめる。"}, {"forms": ["絶つ"], "gloss": "続くはずのものを途中で切る。途絶える。"}, {"forms": ["裁つ"], "gloss": "布や紙をある寸法に合わせて切る。"}]},
    {"id": 78, "reading": "たつ・たてる", "page": 21, "variants": [{"forms": ["立つ", "立てる"], "gloss": "直立する。ある状況や立場に身を置く。離れる。成立する。"}, {"forms": ["建つ", "建てる"], "gloss": "建物や国などを造る。"}]},
    {"id": 79, "reading": "たっとい・たっとぶ・とうとい・とうとぶ", "page": 21, "variants": [{"forms": ["尊い", "尊ぶ"], "gloss": "尊厳があり敬うべきである。"}, {"forms": ["貴い", "貴ぶ"], "gloss": "貴重である。"}]},
    {"id": 80, "reading": "たま", "page": 21, "variants": [{"forms": ["玉"], "gloss": "宝石。円形や球体のもの。"}, {"forms": ["球"], "gloss": "球技に使うボール。電球。"}, {"forms": ["弾"], "gloss": "弾丸。"}]},
    {"id": 81, "reading": "つかう", "page": 22, "variants": [{"forms": ["使う"], "gloss": "人や物などを用いる。"}, {"forms": ["遣う"], "gloss": "十分に働かせる。"}]},
    {"id": 82, "reading": "つく・つける", "page": 22, "variants": [{"forms": ["付く", "付ける"], "gloss": "付着する。加わる。意識などを働かせる。"}, {"forms": ["着く", "着ける"], "gloss": "達する。ある場所を占める。着る。"}, {"forms": ["就く", "就ける"], "gloss": "仕事や役職，ある状況などに身を置く。"}]},
    {"id": 83, "reading": "つぐ", "page": 22, "variants": [{"forms": ["次ぐ"], "gloss": "すぐ後に続く。"}, {"forms": ["継ぐ"], "gloss": "後を受けて続ける。足す。"}, {"forms": ["接ぐ"], "gloss": "つなぎ合わせる。"}]},
    {"id": 84, "reading": "つくる", "page": 22, "variants": [{"forms": ["作る"], "gloss": "こしらえる。"}, {"forms": ["造る"], "gloss": "大きなものをこしらえる。醸造する。"}, {"forms": ["創る"], "gloss": "独創性のあるものを生み出す。"}]},
    {"id": 85, "reading": "つつしむ", "page": 22, "variants": [{"forms": ["慎む"], "gloss": "控え目にする。"}, {"forms": ["謹む"], "gloss": "かしこまる。"}]},
    {"id": 86, "reading": "つとまる・つとめる", "page": 23, "variants": [{"forms": ["勤まる", "勤める"], "gloss": "給料をもらって仕事をする。仏事を行う。"}, {"forms": ["務まる", "務める"], "gloss": "役目や任務を果たす。"}, {"forms": ["努める"], "gloss": "力を尽くす。努力する。"}]},
    {"id": 87, "reading": "とかす・とく・とける", "page": 23, "variants": [{"forms": ["解かす", "解く", "解ける"], "gloss": "固まっていたものが緩む。答えを出す。元の状態に戻る。"}, {"forms": ["溶かす", "溶く", "溶ける"], "gloss": "液状にする。固形物などを液体に入れて混ぜる。一体となる。"}]},
    {"id": 88, "reading": "ととのう・ととのえる", "page": 23, "variants": [{"forms": ["整う", "整える"], "gloss": "乱れがない状態になる。"}, {"forms": ["調う", "調える"], "gloss": "必要なものがそろう。望ましい状態にする。"}]},
    {"id": 89, "reading": "とぶ", "page": 23, "variants": [{"forms": ["飛ぶ"], "gloss": "空中を移動する。速く移動する。広まる。順序どおりでなく先に進む。"}, {"forms": ["跳ぶ"], "gloss": "地面を蹴って高く上がる。"}]},
    {"id": 90, "reading": "とまる・とめる", "page": 23, "variants": [{"forms": ["止まる", "止める"], "gloss": "動きがなくなる。"}, {"forms": ["留まる", "留める"], "gloss": "固定される。感覚に残る。とどめる。"}, {"forms": ["泊まる", "泊める"], "gloss": "宿泊する。停泊する。"}]},
    {"id": 91, "reading": "とらえる", "page": 24, "variants": [{"forms": ["捕らえる"], "gloss": "取り押さえる。"}, {"forms": ["捉える"], "gloss": "的確につかむ。"}]},
    {"id": 92, "reading": "とる", "page": 24, "variants": [{"forms": ["取る"], "gloss": "手で持つ。手に入れる。書き記す。つながる。除く。"}, {"forms": ["採る"], "gloss": "採取する。採用する。採決する。"}, {"forms": ["執る"], "gloss": "手に持って使う。役目として事に当たる。"}, {"forms": ["捕る"], "gloss": "つかまえる。"}, {"forms": ["撮る"], "gloss": "撮影する。"}]},
    {"id": 93, "reading": "ない", "page": 24, "variants": [{"forms": ["無い"], "gloss": "（⇔有る・在る）。存在しない。所有していない。"}, {"forms": ["亡い"], "gloss": "死んでこの世にいない。"}]},
    {"id": 94, "reading": "なおす・なおる", "page": 24, "variants": [{"forms": ["直す", "直る"], "gloss": "正しい状態に戻す。置き換える。"}, {"forms": ["治す", "治る"], "gloss": "病気やけがから回復する。"}]},
    {"id": 95, "reading": "なか", "page": 24, "variants": [{"forms": ["中"], "gloss": "（⇔外）。ある範囲や状況の内側。中間。"}, {"forms": ["仲"], "gloss": "人と人との関係。"}]},
    {"id": 96, "reading": "ながい", "page": 25, "variants": [{"forms": ["長い"], "gloss": "（⇔短い）。距離や時間などの間隔が大きい。"}, {"forms": ["永い"], "gloss": "永久・永遠と感じられるくらい続くさま。"}]},
    {"id": 97, "reading": "ならう", "page": 25, "variants": [{"forms": ["習う"], "gloss": "教わる。繰り返して身に付ける。"}, {"forms": ["倣う"], "gloss": "手本としてまねる。"}]},
    {"id": 98, "reading": "におい・におう", "page": 25, "variants": [{"forms": ["匂い", "匂う"], "gloss": "主に良いにおい。"}, {"forms": ["臭い", "臭う"], "gloss": "主に不快なにおいや好ましくないにおい。"}]},
    {"id": 99, "reading": "のせる・のる", "page": 25, "variants": [{"forms": ["乗せる", "乗る"], "gloss": "乗り物に乗る。運ばれる。応じる。だます。勢い付く。"}, {"forms": ["載せる", "載る"], "gloss": "積む。上に置く。掲載する。"}]},
    {"id": 100, "reading": "のぞむ", "page": 25, "variants": [{"forms": ["望む"], "gloss": "遠くを眺める。希望する。"}, {"forms": ["臨む"], "gloss": "面する。参加する。対する。"}]},
    {"id": 101, "reading": "のばす・のびる・のべる", "page": 25, "variants": [{"forms": ["伸ばす", "伸びる", "伸べる"], "gloss": "まっすぐする。増す。そのものが長くなる。差し出す。"}, {"forms": ["延ばす", "延びる", "延べる"], "gloss": "遅らす。つながって長くなる。重複も認め合計する。広げる。"}]},
    {"id": 102, "reading": "のぼる", "page": 26, "variants": [{"forms": ["上る"], "gloss": "（⇔下る）。上方に向かう。達する。取り上げられる。"}, {"forms": ["登る"], "gloss": "自らの力で高い所へと移動する。"}, {"forms": ["昇る"], "gloss": "（⇔降りる・沈む）。一気に高く上がる。"}]},
    {"id": 103, "reading": "はえ・はえる", "page": 26, "variants": [{"forms": ["映え", "映える"], "gloss": "光を受けて照り輝く。引き立って見える。"}, {"forms": ["栄え", "栄える"], "gloss": "立派に感じられる。目立つ。"}]},
    {"id": 104, "reading": "はかる", "page": 26, "variants": [{"forms": ["図る"], "gloss": "あることが実現するように企てる。"}, {"forms": ["計る"], "gloss": "時間や数などを数える。考える。"}, {"forms": ["測る"], "gloss": "長さ・高さ・深さ・広さ・程度を調べる。推測する。"}, {"forms": ["量る"], "gloss": "重さ・容積を調べる。推量する。"}, {"forms": ["謀る"], "gloss": "良くない事をたくらむ。"}, {"forms": ["諮る"], "gloss": "ある問題について意見を聞く。"}]},
    {"id": 105, "reading": "はじまる・はじめ・はじめて・はじめる", "page": 26, "variants": [{"forms": ["初め", "初めて"], "gloss": "ある期間の早い段階。最初。先の方のもの。"}, {"forms": ["始まる", "始め", "始める"], "gloss": "開始する。始めたばかりの段階。物事の起こり。主たるもの。"}]},
    {"id": 106, "reading": "はな", "page": 27, "variants": [{"forms": ["花"], "gloss": "植物の花（特に桜の花）。花のように人目を引くもの。"}, {"forms": ["華"], "gloss": "きらびやかで美しい様子。本質を成す最も重要な部分。"}]},
    {"id": 107, "reading": "はなす・はなれる", "page": 27, "variants": [{"forms": ["離す", "離れる"], "gloss": "距離や間隔が広がる。離脱する。"}, {"forms": ["放す", "放れる"], "gloss": "拘束や固定を外す。放棄する。"}]},
    {"id": 108, "reading": "はやい・はやまる・はやめる", "page": 27, "variants": [{"forms": ["早い", "早まる", "早める"], "gloss": "時期や時刻が前である。時間が短い。予定よりも前になる。"}, {"forms": ["速い", "速まる", "速める"], "gloss": "スピードがある。速度が上がる。"}]},
    {"id": 109, "reading": "はる", "page": 27, "variants": [{"forms": ["張る"], "gloss": "広がる。引き締まる。取り付ける。押し通す。"}, {"forms": ["貼る"], "gloss": "のりなどで表面に付ける。"}]},
    {"id": 110, "reading": "ひく", "page": 27, "variants": [{"forms": ["引く"], "gloss": "近くに寄せる。線を描く。参照する。やめる。注意や関心などを向けさせる。"}, {"forms": ["弾く"], "gloss": "弦楽器や鍵盤楽器を奏でる。"}]},
    {"id": 111, "reading": "ふえる・ふやす", "page": 28, "variants": [{"forms": ["増える", "増やす"], "gloss": "（⇔減る・減らす）。数や量が多くなる。"}, {"forms": ["殖える", "殖やす"], "gloss": "財産や動植物が多くなる。"}]},
    {"id": 112, "reading": "ふく", "page": 28, "variants": [{"forms": ["吹く"], "gloss": "空気が流れ動く。息を出す。表面に現れる。"}, {"forms": ["噴く"], "gloss": "気体や液体などが内部から外部へ勢いよく出る。"}]},
    {"id": 113, "reading": "ふける", "page": 28, "variants": [{"forms": ["更ける"], "gloss": "深まる。"}, {"forms": ["老ける"], "gloss": "年を取る。"}]},
    {"id": 114, "reading": "ふね", "page": 28, "variants": [{"forms": ["船"], "gloss": "比較的大型のもの。"}, {"forms": ["舟"], "gloss": "主に小型で簡単な作りのもの。"}]},
    {"id": 115, "reading": "ふるう", "page": 28, "variants": [{"forms": ["振るう"], "gloss": "盛んになる。勢いよく動かす。"}, {"forms": ["震う"], "gloss": "小刻みに揺れ動く。"}, {"forms": ["奮う"], "gloss": "気力があふれる。"}]},
    {"id": 116, "reading": "ほか", "page": 29, "variants": [{"forms": ["外"], "gloss": "ある範囲から出たところ。"}, {"forms": ["他"], "gloss": "それとは異なるもの。"}]},
    {"id": 117, "reading": "まざる・まじる・まぜる", "page": 29, "variants": [{"forms": ["交ざる", "交じる", "交ぜる"], "gloss": "主に，元の素材が判別できる形で一緒になる。"}, {"forms": ["混ざる", "混じる", "混ぜる"], "gloss": "主に，元の素材が判別できない形で一緒になる。"}]},
    {"id": 118, "reading": "まち", "page": 29, "variants": [{"forms": ["町"], "gloss": "行政区画の一つ。人家が多く集まった地域。"}, {"forms": ["街"], "gloss": "商店が並んだにぎやかな通りや地域。"}]},
    {"id": 119, "reading": "まるい", "page": 29, "variants": [{"forms": ["丸い"], "gloss": "球形である。角がない。"}, {"forms": ["円い"], "gloss": "円の形である。円満である。"}]},
    {"id": 120, "reading": "まわり", "page": 29, "variants": [{"forms": ["回り"], "gloss": "回転。身辺。円筒形の周囲。"}, {"forms": ["周り"], "gloss": "周囲。周辺。"}]},
    {"id": 121, "reading": "みる", "page": 29, "variants": [{"forms": ["見る"], "gloss": "眺める。調べる。世話する。"}, {"forms": ["診る"], "gloss": "診察する。"}]},
    {"id": 122, "reading": "もと", "page": 29, "variants": [{"forms": ["下"], "gloss": "影響力や支配力の及ぶ範囲。…という状態・状況で。物の下の辺り。"}, {"forms": ["元"], "gloss": "物事が生じる始まり。以前。近くの場所。もとで。"}, {"forms": ["本"], "gloss": "（⇔末）。物事の根幹となる部分。"}, {"forms": ["基"], "gloss": "基礎・土台・根拠。"}]},
    {"id": 123, "reading": "や", "page": 30, "variants": [{"forms": ["屋"], "gloss": "建物。職業。屋号。ある性質を持つ人。"}, {"forms": ["家"], "gloss": "人が生活する住まい。"}]},
    {"id": 124, "reading": "やさしい", "page": 30, "variants": [{"forms": ["優しい"], "gloss": "思いやりがある。穏やかである。上品で美しい。"}, {"forms": ["易しい"], "gloss": "（⇔難しい）。たやすい。分かりやすい。"}]},
    {"id": 125, "reading": "やぶれる", "page": 30, "variants": [{"forms": ["破れる"], "gloss": "引き裂くなどして壊れる。損なわれる。"}, {"forms": ["敗れる"], "gloss": "負ける。"}]},
    {"id": 126, "reading": "やわらかい・やわらかだ", "page": 30, "variants": [{"forms": ["柔らかい", "柔らかだ"], "gloss": "ふんわりしている。しなやかである。穏やかである。"}, {"forms": ["軟らかい", "軟らかだ"], "gloss": "（⇔硬い）。手応えや歯応えがない。緊張や硬さがない。"}]},
    {"id": 127, "reading": "よ", "page": 30, "variants": [{"forms": ["世"], "gloss": "その時の世の中。"}, {"forms": ["代"], "gloss": "ある人や同じ系統の人が国を治めている期間。"}]},
    {"id": 128, "reading": "よい", "page": 31, "variants": [{"forms": ["良い"], "gloss": "優れている。好ましい。"}, {"forms": ["善い"], "gloss": "道徳的に望ましい。"}]},
    {"id": 129, "reading": "よむ", "page": 31, "variants": [{"forms": ["読む"], "gloss": "声に出して言う。内容を理解する。推測する。"}, {"forms": ["詠む"], "gloss": "詩歌を作る。"}]},
    {"id": 130, "reading": "わかれる", "page": 31, "variants": [{"forms": ["分かれる"], "gloss": "一つのものが別々の幾つかになる。違いが生じる。"}, {"forms": ["別れる"], "gloss": "一緒にいた身内や友人などと離れる。"}]},
    {"id": 131, "reading": "わく", "page": 31, "variants": [{"forms": ["沸く"], "gloss": "水が熱くなったり沸騰したりする。興奮・熱狂する。"}, {"forms": ["湧く"], "gloss": "地中から噴き出る。感情や考えなどが生じる。次々と起こる。"}]},
    {"id": 132, "reading": "わざ", "page": 31, "variants": [{"forms": ["技"], "gloss": "技術・技芸。格闘技などで一定の型に従った動作。"}, {"forms": ["業"], "gloss": "行いや振る舞い。仕事。"}]},
    {"id": 133, "reading": "わずらう", "page": 31, "variants": [{"forms": ["煩う"], "gloss": "迷い悩む。"}, {"forms": ["患う"], "gloss": "病気になる。"}]}
  ]
}
